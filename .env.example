# ========================
# Go2Car Backend - Environment Variables
# ========================

# Application
APP_NAME=Go2Car
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./go2car.db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Admin
FIRST_ADMIN_EMAIL=admin@go2car.com
FIRST_ADMIN_PASSWORD=Admin@123456

# Send Email
SENDGRID_API_KEY=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

